{
  "name": "dashboard",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "npm install && pip3 install --user semgrep && npx playwright install --with-deps chromium",
  "forwardPorts": [5173, 8787],
  "portsAttributes": {
    "5173": { "label": "Vite web" },
    "8787": { "label": "Hono API" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
