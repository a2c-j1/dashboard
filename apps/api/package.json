    "hono": "^4.7.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.15.3",
    "eslint": "^9.24.0",
    "prisma": "^6.6.0",
    "testcontainers": "^11.0.2",
    "tsx": "^4.19.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.1.2"
